{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/local/share/atlas/atlas-logo-compact.txt",
    "color": {
      "1": "38;2;245;248;255",
      "2": "38;2;0;174;239"
    },
    "padding": {
      "right": 3
    }
  },
  "display": {
    "color": "34"
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    { "type": "shell", "format": "atsh 1.0 (Bash {4})" },
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors"
  ]
}
