[Unit]
Description=ATLAS WebScreen local web interface
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=sami
Group=sami
WorkingDirectory=/home/atlas/.atlas/webscreen
Environment=ATLAS_WEBSCREEN_HOST=0.0.0.0
Environment=ATLAS_WEBSCREEN_SESSION_IDLE=1800
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/atlas/.atlas/webscreen/start.sh
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
