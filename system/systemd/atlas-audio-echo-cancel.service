[Unit]
Description=ATLAS A1 acoustic echo cancellation
After=user@1000.service sound.target
Wants=user@1000.service
Before=atlas-screen-kiosk.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/atlas-audio-echo-cancel start
ExecStop=/usr/local/libexec/atlas-audio-echo-cancel stop
RemainAfterExit=yes
TimeoutStartSec=15

[Install]
WantedBy=multi-user.target
