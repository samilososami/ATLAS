[Unit]
Description=ATLAS Virtual Desktop
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sami
Group=sami
WorkingDirectory=/home/atlas/.atlas/desktop
Environment=ATLAS_DESKTOP_DISPLAY_NUM=1
Environment=ATLAS_DESKTOP_WIDTH=1920
Environment=ATLAS_DESKTOP_HEIGHT=1080
ExecStart=/home/atlas/.atlas/desktop/bin/start-desktop
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
