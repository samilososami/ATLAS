[Unit]
Description=Start the selected ATLAS physical screen surface after boot
After=systemd-user-sessions.service plymouth-quit.service atlas-webscreen.service network-online.target
Wants=network-online.target
Conflicts=atlas-screen-boot-off.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/atlas-screen boot
TimeoutStartSec=150s

[Install]
WantedBy=multi-user.target
