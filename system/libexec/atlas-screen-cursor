#!/usr/bin/env python3
"""Keep touch-only X11 surfaces cursorless; recheck real mice on hotplug."""
import ctypes
import ctypes.util
import glob
import signal
import subprocess
import time


def mouse_present(paths=None, query=None):
    paths = glob.glob('/sys/class/input/event*') if paths is None else paths
    query = query or (lambda path: subprocess.check_output(
        ['udevadm', 'info', '--query=property', '--path=' + path],
        text=True, stderr=subprocess.DEVNULL, timeout=1))
    for path in paths:
        try:
            properties = dict(line.split('=', 1) for line in query(path).splitlines() if '=' in line)
        except (OSError, subprocess.SubprocessError):
            continue
        if (properties.get('ID_INPUT_MOUSE') == '1'
                and properties.get('ID_INPUT_TOUCHSCREEN') != '1'
                and properties.get('ID_BUS') in ('usb', 'bluetooth')):
            return True
    return False


def main():
    x11 = ctypes.CDLL(ctypes.util.find_library('X11'))
    fixes = ctypes.CDLL(ctypes.util.find_library('Xfixes'))
    x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
    x11.XOpenDisplay.restype = ctypes.c_void_p
    x11.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
    x11.XDefaultRootWindow.restype = ctypes.c_ulong
    x11.XFlush.argtypes = [ctypes.c_void_p]
    x11.XCloseDisplay.argtypes = [ctypes.c_void_p]
    for name in ('XFixesHideCursor', 'XFixesShowCursor'):
        getattr(fixes, name).argtypes = [ctypes.c_void_p, ctypes.c_ulong]
    display = x11.XOpenDisplay(None)
    if not display:
        raise RuntimeError('ATLAS cursor watcher cannot open the physical display')
    root = x11.XDefaultRootWindow(display)
    hidden = False
    running = True

    def stop(*_):
        nonlocal running
        running = False

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    try:
        while running:
            should_hide = not mouse_present()
            if should_hide != hidden:
                (fixes.XFixesHideCursor if should_hide else fixes.XFixesShowCursor)(display, root)
                x11.XFlush(display)
                hidden = should_hide
                print('ATLAS cursor: ' + ('hidden (touch only)' if hidden else 'visible (mouse connected)'), flush=True)
            time.sleep(1)
    finally:
        if hidden:
            fixes.XFixesShowCursor(display, root)
            x11.XFlush(display)
        x11.XCloseDisplay(display)


if __name__ == '__main__':
    main()
