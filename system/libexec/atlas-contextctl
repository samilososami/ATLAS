#!/usr/bin/env python3
"""Small local controller for the resettable ATLAS WebScreen context."""

from __future__ import annotations

import os
import sys
from pathlib import Path
from uuid import uuid4


ROOT = Path(os.environ.get("ATLAS_CONTEXT_DIR", "/home/atlas/.atlas/context"))
CONTEXT = ROOT / "CONTEXT.md"
REVISION = ROOT / "REVISION"
REQUEST = ROOT / "COMPACT_REQUEST"


def estimate_tokens(value: str) -> int:
    return round(len(value) / 4.3)


def write_atomic(path: Path, content: str) -> None:
    temporary = ROOT / f".{path.name}-{uuid4().hex}.tmp"
    temporary.write_text(content, encoding="utf-8")
    temporary.chmod(0o600)
    temporary.replace(path)


def revision() -> str:
    value = uuid4().hex
    write_atomic(REVISION, value + "\n")
    return value


def status() -> int:
    try:
        content = CONTEXT.read_text(encoding="utf-8")
    except OSError:
        content = ""
    print("atlas-context status")
    print(f"File: {CONTEXT}")
    print(f"Conversational memory: approximately {estimate_tokens(content)} tokens")
    print(f"Semantic compaction pending: {'yes' if REQUEST.exists() else 'no'}")
    return 0


def empty() -> int:
    ROOT.mkdir(parents=True, exist_ok=True, mode=0o700)
    write_atomic(CONTEXT, "")
    try:
        REQUEST.unlink()
    except FileNotFoundError:
        pass
    revision()
    print("WebScreen conversational context emptied. Crucial Markdown context is unchanged.")
    return 0


def compact() -> int:
    ROOT.mkdir(parents=True, exist_ok=True, mode=0o700)
    write_atomic(REQUEST, "requested\n")
    print("Semantic compaction requested. The next active ATLAS WebScreen session will compact and restart itself.")
    return 0


def main() -> int:
    action = sys.argv[1] if len(sys.argv) == 2 else "status"
    if action == "status":
        return status()
    if action == "empty":
        return empty()
    if action == "compact":
        return compact()
    print("usage: atlas-contextctl <status|empty|compact>", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
