#!/usr/bin/env bash
set -euo pipefail
if [ "$EUID" -eq 0 ]; then
  exec runuser -u sami -- env HOME=/home/atlas USER=sami LOGNAME=sami \
    DISPLAY=:0 XAUTHORITY=/run/atlas-screen-kiosk/Xauthority \
    XDG_RUNTIME_DIR=/run/user/1000 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus \
    PULSE_SERVER=unix:/run/user/1000/pulse/native \
    PULSE_SINK=alsa_output.platform-107c701400.hdmi.hdmi-stereo \
    PULSE_SOURCE=alsa_input.usb-Jieli_Technology_UACDemoV1.0-00.mono-fallback \
    /usr/local/libexec/atlas-screen-kiosk-session
fi

export PATH=/usr/local/bin:/usr/bin:/bin
export LANG=en_GB.UTF-8
export GTK_USE_PORTAL=0
umask 077
profile=/home/atlas/.atlas/screen/chrome-profile
page_url='http://localhost:5000/?kiosk=1'
if [[ "$(tr -d '[:space:]' </home/atlas/.atlas/screen/web-design 2>/dev/null || true)" == atlas-new ]]; then
  page_url='http://localhost:5000/new/?kiosk=1'
fi
mkdir -p "$profile"
xset -dpms s off s noblank
xsetroot -solid '#040b18'

openbox --config-file /etc/atlas/openbox-kiosk.xml &
wm_pid=$!
/usr/local/libexec/atlas-screen-cursor &
cursor_pid=$!
browser_pid=""
cleanup() {
  [ -z "$browser_pid" ] || kill "$browser_pid" 2>/dev/null || true
  kill "$cursor_pid" "$wm_pid" 2>/dev/null || true
  wait 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 0' INT TERM

# Repair the boot-with-HDMI-off case before opening the microphone/browser.
# This is a bounded startup check, not another background audio watcher.
/usr/local/libexec/atlas-screen-audio-ready || true

for _ in $(seq 1 60); do
  if curl -fsS --max-time 1 http://localhost:5000/ >/dev/null; then break; fi
  sleep 0.5
done

# The physical kiosk accumulated 1.9 GiB of renderer-owned shared buffers and
# then looped on TransferBuffer::Initialize failures while HTTP stayed healthy.
# Keep this CSS/DOM interface on software compositing rather than forcing GLES.
# This contains the graphics allocation failure; it is not proof of a driver
# root cause. Do not redirect shared memory into /tmp or disable the sandbox,
# Chrome's GPU watchdog, WebRTC, or the existing audio route.
/usr/bin/node /usr/local/libexec/atlas-screen-browser-watchdog.cjs \
  google-chrome-stable --ozone-platform=x11 --disable-gpu --disable-gpu-compositing \
  --kiosk --no-first-run --no-default-browser-check \
  --enable-logging=stderr \
  --password-store=basic --lang=es-ES --disable-features=Translate \
  --enable-speech-dispatcher \
  --disable-session-crashed-bubble --disable-pinch \
  --autoplay-policy=no-user-gesture-required --user-data-dir="$profile" \
  --window-size=1024,600 --window-position=0,0 \
  "$page_url" &
browser_pid=$!

# The watchdog writes ready only after the renderer executes a document probe.
# A Chrome sad-tab retains both its window and browser process, so neither is
# a sufficient readiness/recovery test. Keep X11 and the hidden overlay alive.
wait "$browser_pid"
