    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <queries><intent><action android:name="android.speech.RecognitionService" /></intent></queries>
    <application android:label="ATLAS" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false" android:usesCleartextTraffic="false" android:theme="@style/AtlasTheme">
        <provider android:name=".UpdateApkProvider" android:authorities="${applicationId}.updates" android:exported="false" android:grantUriPermissions="true" />
        <service android:name=".AtlasLinkService" android:foregroundServiceType="connectedDevice" android:exported="false" android:stopWithTask="false" />
        <receiver android:name=".AtlasBootReceiver" android:exported="true">
            <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /><action android:name="android.intent.action.MY_PACKAGE_REPLACED" /></intent-filter>
        </receiver>
        <receiver android:name=".AtlasWidgetProvider" android:label="ATLAS · Resumen de A1" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/atlas_widget_info" />
        </receiver>
        <receiver android:name=".ActionWidgetProvider" android:label="ATLAS · Botón" android:exported="false"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/atlas_widget_info" /></receiver>
        <receiver android:name=".QuotaWidgetProvider" android:label="ATLAS · Límites de Codex" android:exported="false"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/atlas_widget_info" /></receiver>
        <receiver android:name=".CpuWidgetProvider" android:label="ATLAS · CPU" android:exported="false"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/atlas_widget_info" /></receiver>
        <receiver android:name=".RamWidgetProvider" android:label="ATLAS · RAM" android:exported="false"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/atlas_widget_info" /></receiver>
        <receiver android:name=".ChatWidgetProvider" android:label="ATLAS · Chat" android:exported="false"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/atlas_widget_info" /></receiver>
        <receiver android:name=".VoiceWidgetProvider" android:label="ATLAS · Voz" android:exported="false"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/atlas_widget_info" /></receiver>
        <service android:name=".WidgetRefreshJob" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="true" />
        <activity android:name=".WidgetConfigureActivity" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter>
        </activity>
        <activity android:name=".MainActivity" android:launchMode="singleTop" android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
    </application>
</manifest>
