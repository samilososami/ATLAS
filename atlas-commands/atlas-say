#!/usr/bin/env python3
import argparse
import datetime as dt
import json
import os
import pathlib
import stat
import subprocess
import sys

import requests

ATLAS_HOME = pathlib.Path(os.environ.get("ATLAS_HOME", "/home/atlas"))
CONFIG_PATH = pathlib.Path(
    os.environ.get("ATLAS_SECRETS_FILE", ATLAS_HOME / ".atlas/config/secrets.json")
)
TMP_DIR = pathlib.Path(
    os.environ.get("ATLAS_RUNTIME_TMP", ATLAS_HOME / ".atlas/runtime/tmp")
)
def die(message: str, code: int = 1) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(code)


def load_config() -> dict:
    try:
        mode = CONFIG_PATH.stat().st_mode
        if stat.S_IMODE(mode) != 0o600:
            die(f"ATLAS secrets must be private (chmod 600): {CONFIG_PATH}")
        value = json.loads(CONFIG_PATH.read_text())
    except FileNotFoundError:
        die(f"ATLAS secrets not found: {CONFIG_PATH}. Run the ATLAS runtime migration first.")
    except OSError as exc:
        die(f"ATLAS secrets could not be read ({exc.__class__.__name__}): {CONFIG_PATH}")
    except json.JSONDecodeError as exc:
        die(f"ATLAS secrets are not valid JSON: {exc}")
    if not isinstance(value, dict):
        die(f"ATLAS secrets must contain a JSON object: {CONFIG_PATH}")
    return value


def config_get(data: dict, path: str):
    cur = data
    for part in path.split("."):
        if not isinstance(cur, dict) or part not in cur:
            return None
        cur = cur[part]
    return cur


def resolve_elevenlabs_config(data: dict, voice_id_override: str | None = None) -> tuple[str, str]:
    api_key = (
        os.environ.get("ELEVENLABS_API_KEY")
        or config_get(data, "elevenlabs.apiKey")
    )
    voice_id = (
        voice_id_override
        or os.environ.get("ELEVENLABS_VOICE_ID")
        or config_get(data, "elevenlabs.voiceId")
    )
    if isinstance(api_key, dict):
        die("ElevenLabs API key is an object. atlas-say expects a resolved string or ELEVENLABS_API_KEY.")
    if not api_key:
        die("ElevenLabs API key not found in ATLAS secrets or ELEVENLABS_API_KEY.")
    if not voice_id:
        die("ElevenLabs voice ID not found in ATLAS secrets or ELEVENLABS_VOICE_ID.")
    return str(api_key), str(voice_id)


def build_text(parts: list[str]) -> str:
    text = " ".join(parts).strip()
    if not text and not sys.stdin.isatty():
        text = sys.stdin.read().strip()
    if not text:
        die('usage: atlas-say "text to speak"', 2)
    return text


def synthesize_elevenlabs(text: str, api_key: str, voice_id: str) -> pathlib.Path:
    TMP_DIR.mkdir(parents=True, mode=0o700, exist_ok=True)
    try:
        TMP_DIR.chmod(0o700)
    except PermissionError:
        pass
    ts = dt.datetime.now().strftime("%Y%m%d-%H%M%S-%f")
    out = TMP_DIR / f"atlas-say-{ts}.mp3"
    model_id = os.environ.get("ATLAS_SAY_ELEVENLABS_MODEL", "eleven_multilingual_v2")
    url = f"https://api.elevenlabs.io/v1/text-to-speech/{voice_id}"
    params = {"output_format": os.environ.get("ATLAS_SAY_OUTPUT_FORMAT", "mp3_44100_128")}
    payload = {
        "text": text,
        "model_id": model_id,
        "voice_settings": {
            "stability": float(os.environ.get("ATLAS_SAY_STABILITY", "0.45")),
            "similarity_boost": float(os.environ.get("ATLAS_SAY_SIMILARITY_BOOST", "0.8")),
        },
    }
    headers = {
        "xi-api-key": api_key,
        "Content-Type": "application/json",
        "Accept": "audio/mpeg",
    }
    try:
        response = requests.post(url, params=params, headers=headers, json=payload, timeout=60)
    except requests.RequestException as exc:
        die(f"ElevenLabs request failed: {exc}")
    if response.status_code >= 400:
        detail = response.text[:500].replace(api_key, "<redacted>")
        die(f"ElevenLabs returned HTTP {response.status_code}: {detail}")
    out.write_bytes(response.content)
    try:
        owner = TMP_DIR.stat()
        os.chown(out, owner.st_uid, owner.st_gid)
    except (OSError, PermissionError):
        pass
    return out


def play_audio(path: pathlib.Path) -> None:
    players = [
        ["ffplay", "-nodisp", "-autoexit", "-loglevel", "quiet", str(path)],
        ["mpv", "--no-video", "--really-quiet", str(path)],
        ["mpg123", "-q", str(path)],
    ]
    for cmd in players:
        if subprocess.run(["bash", "-lc", f"command -v {cmd[0]} >/dev/null 2>&1"]).returncode == 0:
            result = subprocess.run(cmd)
            if result.returncode == 0:
                return
            die(f"audio player failed: {' '.join(cmd)}", result.returncode)
    die("no audio player found. Install ffmpeg/ffplay, mpv, or mpg123.")


def main() -> int:
    parser = argparse.ArgumentParser(description="Make ATLAS speak through the default audio output.")
    parser.add_argument("--tts", default="elevenlabs", choices=["elevenlabs"], help="TTS backend (ElevenLabs)")
    parser.add_argument("--voiceid", default=None, help="ElevenLabs voice ID override for this utterance. Used with --tts elevenlabs.")
    parser.add_argument("--no-play", action="store_true", help="Generate the audio file but do not play it.")
    parser.add_argument("text", nargs="*", help="Text to speak. If omitted, stdin is used.")
    if len(sys.argv) == 2 and sys.argv[1] in {"help", "-h", "--help"}:
        parser.print_help()
        return 0
    args = parser.parse_args()

    text = build_text(args.text)
    config = load_config()
    api_key, voice_id = resolve_elevenlabs_config(config, args.voiceid)
    out = synthesize_elevenlabs(text, api_key, voice_id)
    print(f"Audio: {out}")
    if not args.no_play:
        play_audio(out)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
