#!/usr/bin/env python3
"""Fast Android Accessibility control through the paired ATLAS app."""
import argparse, base64, json, os, pathlib, subprocess, sys, time
from urllib.parse import urlparse

ROOT=pathlib.Path(os.environ.get('ATLAS_HOME','/home/atlas'))
NO_ARGUMENT_ACTIONS=('start','stop','status','screenshot','tree','back','home','recents')
LAUNCH_SCHEMES=frozenset(('http','https','geo','tel','sms','mailto'))

def number(value,label,integer=False):
    try: return int(value) if integer else float(value)
    except (TypeError,ValueError): raise SystemExit(f'{label} debe ser un número')

def parameters(action,values):
    if action in NO_ARGUMENT_ACTIONS:
        if values: raise SystemExit(f'Uso: atlas-androiduse {action}')
        return {}
    if action=='tap':
        if len(values)!=2: raise SystemExit('Uso: atlas-androiduse tap X Y')
        return {'x':number(values[0],'X'),'y':number(values[1],'Y')}
    if action=='click':
        if not values: raise SystemExit('Uso: atlas-androiduse click ETIQUETA')
        return {'text':' '.join(values),'exact':True}
    if action=='long_press':
        if len(values) not in (2,3): raise SystemExit('Uso: atlas-androiduse long_press X Y [DURACION_MS]')
        result={'x':number(values[0],'X'),'y':number(values[1],'Y')}
        if len(values)==3: result['duration']=number(values[2],'DURACION_MS',integer=True)
        return result
    if action=='swipe':
        if len(values) not in (4,5): raise SystemExit('Uso: atlas-androiduse swipe X1 Y1 X2 Y2 [DURACION_MS]')
        return {'x1':number(values[0],'X1'),'y1':number(values[1],'Y1'),
                'x2':number(values[2],'X2'),'y2':number(values[3],'Y2'),
                'duration':number(values[4],'DURACION_MS',integer=True) if len(values)==5 else 300}
    if action=='text':
        if not values: raise SystemExit('Uso: atlas-androiduse text TEXTO')
        return {'text':' '.join(values)}
    if action=='key':
        if len(values)!=1: raise SystemExit('Uso: atlas-androiduse key BACK|HOME|RECENTS|ENTER')
        key=values[0].upper()
        if key not in ('BACK','HOME','RECENTS','ENTER'):
            raise SystemExit('Uso: atlas-androiduse key BACK|HOME|RECENTS|ENTER')
        return {'key':key}
    if action=='launch':
        if len(values)!=1: raise SystemExit('Uso: atlas-androiduse launch PAQUETE|URL')
        target=values[0].strip(); scheme=urlparse(target).scheme.lower()
        return {'uri':target} if scheme in LAUNCH_SCHEMES else {'package':target}
    if action=='wait':
        if len(values)>1: raise SystemExit('Uso: atlas-androiduse wait [MILISEGUNDOS]')
        return {'ms':number(values[0],'MILISEGUNDOS',integer=True)} if values else {}
    raise SystemExit('Acción desconocida')

def call(action,params,timeout):
    command=['atlas-app','--json','--timeout',str(timeout),'--params',json.dumps(params,separators=(',',':')),
             'control','androiduse.'+action]
    process=subprocess.run(command,text=True,capture_output=True)
    if process.returncode:
        message=(process.stderr or process.stdout).strip()
        raise SystemExit(message or 'Error: Android device not connected')
    try: return json.loads(process.stdout)
    except ValueError: raise SystemExit('Error: invalid response from Android device')

def save_screenshot(result,target):
    encoded=result.get('imageBase64') or result.get('pngBase64') or result.get('data')
    if not isinstance(encoded,str) or not encoded: raise SystemExit('Error: Android screenshot was empty')
    try: image=base64.b64decode(encoded,validate=True)
    except ValueError: raise SystemExit('Error: Android screenshot was invalid')
    mime=str(result.get('mime') or 'image/png').lower(); signatures={'image/png':b'\x89PNG\r\n\x1a\n','image/jpeg':b'\xff\xd8\xff'}
    if mime not in signatures or not image.startswith(signatures[mime]): raise SystemExit('Error: Android screenshot format was invalid')
    suffix='.jpg' if mime=='image/jpeg' else '.png'
    path=pathlib.Path(target) if target else ROOT/f'.atlas/companion/screenshots/latest{suffix}'
    compatible={'.jpg','.jpeg'} if mime=='image/jpeg' else {'.png'}
    if path.suffix.lower() not in compatible:
        if not path.suffix or path.suffix.lower() in {'.png','.jpg','.jpeg'}: path=path.with_suffix(suffix)
        else: raise SystemExit(f'Error: screenshot target extension must match {mime}')
    if not path.is_absolute(): path=pathlib.Path.cwd()/path
    path.parent.mkdir(parents=True,exist_ok=True); temporary=path.with_suffix(path.suffix+'.tmp')
    temporary.write_bytes(image); temporary.chmod(0o600); os.replace(temporary,path)
    if os.geteuid()==0:
        owner=ROOT.stat(); os.chown(path,owner.st_uid,owner.st_gid); os.chown(path.parent,owner.st_uid,owner.st_gid)
    return {'path':str(path),'width':result.get('captureWidth',result.get('width')),'height':result.get('captureHeight',result.get('height')),'mime':mime,
            'capturedAt':result.get('capturedAt',int(time.time()*1000))}

def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--json',action='store_true')
    parser.add_argument('--timeout',type=float,default=35)
    parser.add_argument('action',choices=('start','stop','status','screenshot','tree','click','tap','long_press','swipe',
                                         'text','key','launch','back','home','recents','wait'))
    parser.add_argument('values',nargs='*')
    args=parser.parse_args(); target=''
    values=args.values
    if args.action=='screenshot' and values:
        if len(values)>1: raise SystemExit('Uso: atlas-androiduse screenshot [RUTA]')
        target=values[0]; values=[]
    result=call(args.action,parameters(args.action,values),args.timeout)
    if args.action=='screenshot': result=save_screenshot(result,target)
    if args.json or isinstance(result,(dict,list)): print(json.dumps(result,ensure_ascii=False))
    else: print(result)

if __name__=='__main__': main()
