#!/usr/bin/env bash
set -euo pipefail

LIGHTDM_SERVICE="lightdm.service"
TERMINAL_SERVICE="atlas-screen-terminal.service"
KIOSK_SERVICE="atlas-screen-kiosk.service"
RAFAS_SERVICE="atlas-rafas.service"
GETTY_SERVICE="getty@tty1.service"
BOOT_ON_SERVICE="atlas-screen-boot-on.service"
BOOT_OFF_SERVICE="atlas-screen-boot-off.service"
DISPLAY_ID=":0"
XAUTHORITY_FILE="/home/atlas/.Xauthority"
MODE_DIR="/home/atlas/.atlas/screen"
MODE_FILE="$MODE_DIR/mode"
BOOT_MODE_FILE="$MODE_DIR/boot-mode"

if [[ "${EUID}" -ne 0 && "${BASH_SOURCE[0]}" == "$0" ]]; then
  exec sudo -n "$0" "$@"
fi

if [ -t 1 ]; then
  BOLD="$(tput bold 2>/dev/null || true)"
  RESET="$(tput sgr0 2>/dev/null || true)"
  CYAN="$(tput setaf 6 2>/dev/null || true)"
else
  BOLD=""
  RESET=""
  CYAN=""
fi

usage() {
  cat >&2 <<'USAGE'
Usage:
  atlas-screen
  atlas-screen on
  atlas-screen off
  atlas-screen --desktop
  atlas-screen --terminal
  atlas-screen --atlas
  atlas-screen --atlas-hide
  atlas-screen --rafas
  atlas-screen --atlas off
  atlas-screen enable
  atlas-screen enable --desktop
  atlas-screen enable --terminal
  atlas-screen enable --atlas
  atlas-screen enable --atlas-hide
  atlas-screen enable --rafas
  atlas-screen enable --last
  atlas-screen disable
Modes switch immediately. "on" opens the selected mode; "off" powers down.
"enable" configures an automatic boot surface; "disable" restores boot-off.
USAGE
  exit 2
}

ensure_mode_store() {
  install -d -o root -g sami -m 755 "$MODE_DIR"
  if [ ! -f "$MODE_FILE" ]; then
    printf 'desktop\n' > "$MODE_FILE"
    chown root:sami "$MODE_FILE"
    chmod 644 "$MODE_FILE"
  fi
}

selected_mode() {
  local mode
  ensure_mode_store
  mode="$(tr -d '[:space:]' < "$MODE_FILE")"
  case "$mode" in
    desktop|terminal|atlas|atlas-hide|rafas) printf '%s\n' "$mode" ;;
    *) printf 'desktop\n' ;;
  esac
}

save_mode() {
  local mode="$1"
  local temporary
  ensure_mode_store
  temporary="$(mktemp "$MODE_DIR/.mode.XXXXXX")"
  printf '%s\n' "$mode" > "$temporary"
  chown root:sami "$temporary"
  chmod 644 "$temporary"
  mv -f "$temporary" "$MODE_FILE"
}

selected_boot_mode() {
  local mode
  ensure_mode_store
  if [ ! -f "$BOOT_MODE_FILE" ]; then
    printf 'last\n'
    return
  fi
  mode="$(tr -d '[:space:]' < "$BOOT_MODE_FILE")"
  case "$mode" in
    desktop|terminal|atlas|atlas-hide|rafas|last) printf '%s\n' "$mode" ;;
    *) printf 'last\n' ;;
  esac
}

save_boot_mode() {
  local mode="$1"
  local temporary
  ensure_mode_store
  temporary="$(mktemp "$MODE_DIR/.boot-mode.XXXXXX")"
  printf '%s\n' "$mode" > "$temporary"
  chown root:sami "$temporary"
  chmod 644 "$temporary"
  mv -f "$temporary" "$BOOT_MODE_FILE"
}

connector_path() {
  local path
  local _
  for _ in $(seq 1 50); do
    for path in /sys/class/drm/card*-HDMI-A-1; do
      if [ -e "$path/status" ]; then
        printf '%s\n' "$path"
        return 0
      fi
    done
    sleep 0.1
  done
  return 1
}

force_connector() {
  local state="$1"
  local path
  if ! path="$(connector_path)"; then
    echo "ATLAS could not find HDMI-A-1." >&2
    exit 1
  fi
  printf '%s' "$state" > "$path/status"
}

set_framebuffer_blank() {
  local value="$1"
  if [ -w /sys/class/graphics/fb0/blank ]; then
    printf '%s' "$value" > /sys/class/graphics/fb0/blank
  fi
}

keep_native_boot_minimal() {
  systemctl disable "$LIGHTDM_SERVICE" >/dev/null 2>&1 || true
  systemctl set-default multi-user.target >/dev/null 2>&1
}

enable_boot_screen() {
  local mode="$1"
  keep_native_boot_minimal
  save_boot_mode "$mode"
  systemctl enable "$BOOT_ON_SERVICE" >/dev/null
  systemctl disable "$BOOT_OFF_SERVICE" >/dev/null
  if [ "$mode" = last ]; then
    echo "ATLAS screen will boot on in the last selected mode."
  else
    echo "ATLAS screen will boot on in ${mode} mode."
  fi
}

disable_boot_screen() {
  keep_native_boot_minimal
  systemctl enable "$BOOT_OFF_SERVICE" >/dev/null
  systemctl disable "$BOOT_ON_SERVICE" >/dev/null
  echo "ATLAS screen will stay off after boot."
}

start_desktop() {
  systemctl stop "$RAFAS_SERVICE" >/dev/null 2>&1 || true
  systemctl stop "$KIOSK_SERVICE" >/dev/null 2>&1 || true
  systemctl stop "$TERMINAL_SERVICE" >/dev/null 2>&1 || true
  systemctl start "$GETTY_SERVICE" >/dev/null 2>&1 || true
  systemctl start "$LIGHTDM_SERVICE"

  for _ in $(seq 1 50); do
    if systemctl is-active --quiet "$LIGHTDM_SERVICE" && [ -e "$XAUTHORITY_FILE" ]; then
      env DISPLAY="$DISPLAY_ID" XAUTHORITY="$XAUTHORITY_FILE" xset dpms force on >/dev/null 2>&1 || true
      return 0
    fi
    sleep 0.1
  done

  echo "ATLAS could not start the physical desktop." >&2
  exit 1
}

start_terminal() {
  systemctl stop "$RAFAS_SERVICE" >/dev/null 2>&1 || true
  systemctl stop "$KIOSK_SERVICE" >/dev/null 2>&1 || true
  if systemctl is-active --quiet "$LIGHTDM_SERVICE"; then
    env DISPLAY="$DISPLAY_ID" XAUTHORITY="$XAUTHORITY_FILE" xset dpms force off >/dev/null 2>&1 || true
  fi
  systemctl stop "$LIGHTDM_SERVICE" >/dev/null 2>&1 || true
  systemctl stop "$GETTY_SERVICE" >/dev/null 2>&1 || true
  systemctl restart "$TERMINAL_SERVICE"
  chvt 1 >/dev/null 2>&1 || true

  for _ in $(seq 1 30); do
    if systemctl is-active --quiet "$TERMINAL_SERVICE"; then
      return 0
    fi
    sleep 0.1
  done

  echo "ATLAS could not start the root terminal." >&2
  exit 1
}

set_atlas_display_power() {
  local state="$1" output=""

  # The TS7 Pro exposes both its panel controls and speakers over HDMI. DDC
  # powers only the panel, so the HDMI audio sink stays available. Never use
  # force_connector off for atlas-hide: that removes the speakers as well.
  if command -v ddcutil >/dev/null 2>&1; then
    if [ "$state" = off ]; then
      if timeout 8s ddcutil --display 1 setvcp D6 4 >/dev/null 2>&1; then
        return 0
      fi
    else
      timeout 8s ddcutil --display 1 setvcp D6 1 >/dev/null 2>&1 || true
    fi
  fi

  # XRandR keeps the HDMI connector (and therefore audio) present. It is also
  # the recovery path if DDC is unavailable on a replacement display.
  output="$(env DISPLAY="$DISPLAY_ID" XAUTHORITY=/run/atlas-screen-kiosk/Xauthority \
    runuser -u sami -- xrandr --query 2>/dev/null | awk '$2 == "connected" { print $1; exit }')"
  [ -n "$output" ] || return 1
  if [ "$state" = off ]; then
    env DISPLAY="$DISPLAY_ID" XAUTHORITY=/run/atlas-screen-kiosk/Xauthority \
      runuser -u sami -- xrandr --output "$output" --off
  else
    env DISPLAY="$DISPLAY_ID" XAUTHORITY=/run/atlas-screen-kiosk/Xauthority \
      runuser -u sami -- xrandr --output "$output" --auto --primary --brightness 1
  fi
}

start_atlas() {
  local display_state="${1:-on}"
  systemctl stop "$RAFAS_SERVICE" >/dev/null 2>&1 || true
  systemctl stop "$LIGHTDM_SERVICE" "$TERMINAL_SERVICE" "$GETTY_SERVICE"
  systemctl start atlas-webscreen.service
  for _ in $(seq 1 180); do
    if curl --fail --silent --max-time 1 http://127.0.0.1:5000/ >/dev/null 2>&1; then
      break
    fi
    if systemctl is-failed --quiet atlas-webscreen.service; then
      echo "ATLAS WebScreen failed before the kiosk could start." >&2
      return 1
    fi
    sleep 0.5
  done
  if ! curl --fail --silent --max-time 1 http://127.0.0.1:5000/ >/dev/null 2>&1; then
    echo "ATLAS WebScreen did not become ready." >&2
    return 1
  fi

  # Toggling atlas <-> atlas-hide must not restart Chrome. A restart would
  # interrupt the Realtime turn that requested the mode change.
  if [ -e /run/atlas-screen-kiosk/ready ] && systemctl is-active --quiet "$KIOSK_SERVICE"; then
    chvt 1 >/dev/null 2>&1 || true
    set_atlas_display_power "$display_state"
    return 0
  fi

  systemctl restart "$KIOSK_SERVICE"
  chvt 1 >/dev/null 2>&1 || true
  for _ in $(seq 1 250); do
    if [ -e /run/atlas-screen-kiosk/ready ] && systemctl is-active --quiet "$KIOSK_SERVICE"; then
      set_atlas_display_power "$display_state"
      return 0
    fi
    if systemctl is-failed --quiet "$KIOSK_SERVICE"; then break; fi
    sleep 0.2
  done
  echo "ATLAS kiosk did not become ready. Check: journalctl -u $KIOSK_SERVICE -n 40" >&2
  return 1
}

start_atlas_hidden() {
  start_atlas off
}

start_rafas() {
  # Bound shutdown of broken graphical surfaces. Only their own cgroups are
  # killed if they ignore TERM; never stop the network, Gateway or backend.
  local service
  for service in "$LIGHTDM_SERVICE" "$TERMINAL_SERVICE" "$KIOSK_SERVICE"; do
    if ! timeout 5s systemctl stop "$service"; then
      systemctl kill --kill-whom=all --signal=KILL "$service" 2>/dev/null || true
      systemctl stop --no-block "$service" 2>/dev/null || true
    fi
  done
  systemctl stop getty@tty8.service >/dev/null 2>&1 || true
  force_connector on
  set_framebuffer_blank 0
  systemctl reset-failed "$RAFAS_SERVICE" 2>/dev/null || true
  systemctl start "$RAFAS_SERVICE"
  chvt 8
  # Switching away from a crashed X server must not leave the framebuffer blank.
  set_framebuffer_blank 0
}

screen_on() {
  local mode
  keep_native_boot_minimal
  mode="$(selected_mode)"
  force_connector on
  set_framebuffer_blank 0

  case "$mode" in
    desktop) start_desktop ;;
    terminal) start_terminal ;;
    atlas) start_atlas ;;
    atlas-hide) start_atlas_hidden ;;
    rafas) start_rafas ;;
  esac

  if [ "$mode" = atlas-hide ]; then
    echo "ATLAS is listening with the physical screen hidden."
  else
    echo "ATLAS screen is on in ${mode} mode."
  fi
}

screen_off() {
  keep_native_boot_minimal
  systemctl stop "$RAFAS_SERVICE" >/dev/null 2>&1 || true

  if systemctl is-active --quiet "$LIGHTDM_SERVICE"; then
    env DISPLAY="$DISPLAY_ID" XAUTHORITY="$XAUTHORITY_FILE" xset dpms force off >/dev/null 2>&1 || true
  fi
  systemctl stop "$LIGHTDM_SERVICE" >/dev/null 2>&1 || true
  systemctl stop "$TERMINAL_SERVICE" >/dev/null 2>&1 || true
  systemctl stop "$KIOSK_SERVICE" >/dev/null 2>&1 || true
  systemctl start "$GETTY_SERVICE" >/dev/null 2>&1 || true

  chvt 1 >/dev/null 2>&1 || true
  set_framebuffer_blank 4
  force_connector off

  echo "ATLAS screen is off."
}

boot_screen_on() {
  local boot_mode mode
  boot_mode="$(selected_boot_mode)"
  if [ "$boot_mode" = last ]; then
    mode="$(selected_mode)"
  else
    mode="$boot_mode"
    save_mode "$mode"
  fi
  screen_on
}

print_status() {
  local mode power active_surface connector connector_status connector_enabled connector_dpms boot_mode boot_default
  mode="$(selected_mode)"
  power="off"
  active_surface="none"
  boot_mode="$(selected_boot_mode)"
  boot_default="off"
  if systemctl is-enabled --quiet "$BOOT_ON_SERVICE" 2>/dev/null; then
    if [ "$boot_mode" = last ]; then
      boot_default="on (last -> $mode)"
    else
      boot_default="on ($boot_mode)"
    fi
  fi

  if connector="$(connector_path 2>/dev/null)"; then
    connector_status="$(cat "$connector/status" 2>/dev/null || true)"
    connector_enabled="$(cat "$connector/enabled" 2>/dev/null || true)"
    connector_dpms="$(cat "$connector/dpms" 2>/dev/null || true)"
    if [ "$connector_status" = "connected" ] && [ "$connector_enabled" = "enabled" ] && [ "$connector_dpms" = "On" ]; then
      power="on"
    fi
  fi

  if systemctl is-active --quiet "$RAFAS_SERVICE"; then
    active_surface="rafas"
  elif systemctl is-active --quiet "$KIOSK_SERVICE"; then
    if [ "$mode" = atlas-hide ]; then
      active_surface="atlas-hide"
      # DDC powers down the panel without changing the DRM connector state.
      power="off"
    else
      active_surface="atlas"
    fi
  elif systemctl is-active --quiet "$LIGHTDM_SERVICE"; then
    active_surface="desktop"
  elif systemctl is-active --quiet "$TERMINAL_SERVICE"; then
    active_surface="terminal"
  elif [ "$power" = "on" ]; then
    active_surface="console"
  fi

  printf '%s%sATLAS SCREEN%s\n' "$BOLD" "$CYAN" "$RESET"
  printf 'Power: %s\n' "$power"
  printf 'Selected mode: %s\n' "$mode"
  printf 'Active surface: %s\n' "$active_surface"
  printf 'Boot default: %s\n' "$boot_default"
}

main() {
  local mode="" action="" boot_mode="" argument value
  # Validate the complete request before changing files, services or HDMI.
  for argument in "$@"; do
    case "$argument" in
      --desktop|--terminal|--atlas|--atlas-hide|--rafas)
        value="${argument#--}"
        [ -z "$mode" ] || [ "$mode" = "$value" ] || usage
        mode="$value"
        ;;
      --RAFAS)
        [ -z "$mode" ] || [ "$mode" = rafas ] || usage
        mode=rafas
        ;;
      --last)
        [ -z "$boot_mode" ] || [ "$boot_mode" = last ] || usage
        boot_mode=last
        ;;
      on|off|enable|disable|boot)
        value="$argument"
        [ -z "$action" ] || [ "$action" = "$value" ] || usage
        action="$value"
        ;;
      -h|--help) usage ;;
      *) usage ;;
    esac
  done
  case "$action" in
    enable)
      if [ -n "$mode" ] && [ -z "$boot_mode" ]; then
        boot_mode="$mode"
      elif [ -n "$mode" ]; then
        usage
      fi
      ;;
    disable)
      [ -z "$mode" ] && [ -z "$boot_mode" ] || usage
      ;;
    boot)
      [ -z "$mode" ] && [ -z "$boot_mode" ] || usage
      ;;
    on|off|"")
      [ -z "$boot_mode" ] || usage
      ;;
  esac
  if [ -n "$mode" ] && [ -z "$action" ]; then
    action=on
  fi
  # A mode switch can stop the very terminal that invoked it. Hand the action
  # to systemd first, so killing that session cannot kill the switch halfway.
  if [[ "$action" == on || "$action" == off ]] && grep -Eq '/(atlas-rafas|atlas-screen-terminal|atlas-screen-kiosk)\.service' "/proc/$$/cgroup"; then
    systemd-run --quiet --collect --no-block --unit="atlas-screen-action-$$" /usr/local/bin/atlas-screen "$@"
    return
  fi
  if [ -n "$mode" ] && [ "$action" != enable ]; then
    save_mode "$mode"
  fi
  case "$action" in
    on) screen_on ;;
    off) screen_off ;;
    enable) enable_boot_screen "${boot_mode:-$(selected_boot_mode)}" ;;
    disable) disable_boot_screen ;;
    boot) boot_screen_on ;;
    "") print_status ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then main "$@"; fi
