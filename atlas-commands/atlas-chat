#!/usr/bin/env bash
set -euo pipefail

ATLAS_USER=${ATLAS_USER:-sami}
ATLAS_HOME=${ATLAS_HOME:-/home/atlas}
PYTHON="$ATLAS_HOME/.atlas/webscreen/.venv/bin/python"
CLIENT="$ATLAS_HOME/.atlas/chat/atlas_chat.py"

if [[ ! -x $PYTHON ]]; then
  echo "atlas-chat: no encuentro el entorno de WebScreen en $PYTHON" >&2
  exit 1
fi
if [[ ! -r $CLIENT ]]; then
  echo "atlas-chat: no encuentro el cliente en $CLIENT" >&2
  exit 1
fi

if (( EUID == 0 )); then
  exec sudo -u "$ATLAS_USER" -H -- env ATLAS_HOME="$ATLAS_HOME" "$PYTHON" "$CLIENT" "$@"
fi

if [[ $(id -un) != "$ATLAS_USER" ]]; then
  echo "atlas-chat: ejecútalo como $ATLAS_USER o como root" >&2
  exit 1
fi

export ATLAS_HOME
exec "$PYTHON" "$CLIENT" "$@"
