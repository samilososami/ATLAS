#!/usr/bin/env python3
"""ATLAS mobile service, pairing and connection diagnostics."""
import argparse, base64, hashlib, json, os, pathlib, secrets, ssl, subprocess, sys, time
from urllib.parse import urlparse
ROOT=pathlib.Path(os.environ.get('ATLAS_HOME','/home/atlas'))
STATE=ROOT/'.atlas/companion/state'
def b64(v): return base64.urlsafe_b64encode(v).decode().rstrip('=')
def config(): return json.loads((STATE/'config.json').read_text())
def save(c):
    STATE.mkdir(parents=True,exist_ok=True); STATE.chmod(0o700)
    p=STATE/'config.tmp'; p.write_text(json.dumps(c)); p.chmod(0o600); os.replace(p,STATE/'config.json')
    owner=ROOT.stat()
    if os.geteuid()==0:
        os.chown(STATE,owner.st_uid,owner.st_gid); os.chown(STATE/'config.json',owner.st_uid,owner.st_gid)
def init():
    if (STATE/'config.json').exists(): return
    if os.geteuid()!=0: raise SystemExit('Usa sudo atlas-app init')
    save({'version':1,'key':b64(secrets.token_bytes(32)),'room':secrets.token_hex(24),
          'relayPassword':secrets.token_urlsafe(32),'relay':''})
    subprocess.run(['openssl','req','-x509','-newkey','rsa:2048','-nodes','-days','3650',
       '-keyout',str(STATE/'private.key'),'-out',str(STATE/'certificate.pem'),
       '-subj','/CN=atlas-a1','-addext','subjectAltName=DNS:atlas-a1.local,DNS:atlas-a1'],check=True,
       stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
    owner=ROOT.stat()
    for p in STATE.iterdir(): p.chmod(0o600); os.chown(p,owner.st_uid,owner.st_gid)
def main():
    ap=argparse.ArgumentParser(description=__doc__)
    ap.add_argument('action',nargs='?',default='status',choices=['status','init','pair','revoke','relay','relay-credentials','start','stop','restart','logs'])
    ap.add_argument('url',nargs='?'); ap.add_argument('--json',action='store_true'); a=ap.parse_args()
    if a.action=='init': init(); print('Servicio preparado. Ejecuta atlas-app pair para emparejar.'); return
    if a.action in ('start','stop','restart'):
        sys.exit(subprocess.call(['sudo','-n','systemctl',a.action,'atlas-companion.service']))
    if a.action=='logs': sys.exit(subprocess.call(['journalctl','-u','atlas-companion.service','-n','60','--no-pager']))
    if a.action=='pair':
        helper=ROOT/'.atlas/companion/ble_pair.py'
        if not helper.exists(): raise SystemExit('Falta el servicio de emparejamiento Bluetooth. Reinstala ATLAS Companion.')
        command=['/usr/bin/python3',str(helper)]
        if os.geteuid()!=0: command=['sudo','-n',*command]
        sys.exit(subprocess.call(command))
    if a.action=='relay':
        if not a.url or urlparse(a.url).scheme!='wss' or not urlparse(a.url).hostname:
            raise SystemExit('Uso: atlas-app relay wss://tu-dominio/connect')
        c=config(); c['relay']=a.url; save(c)
        print('Relay guardado. Reinicia atlas-app y vuelve a emparejar el móvil.'); return
    if a.action=='relay-credentials':
        c=config(); credentials={c['room']:hashlib.sha256(c['relayPassword'].encode()).hexdigest()}
        if not a.json: print('Configuración privada para el relay de ATLAS:')
        print(json.dumps(credentials,indent=None if a.json else 2)); return
    if a.action=='revoke':
        if not sys.stdin.isatty() or input('Revocar TODOS los móviles emparejados [s/N]: ').lower()!='s': return
        c=config(); c['key']=b64(secrets.token_bytes(32)); save(c)
        subprocess.run(['sudo','-n','systemctl','restart','atlas-companion.service'],check=True)
        print('Emparejamientos revocados. Genera un código nuevo.'); return
    service=subprocess.run(['systemctl','is-active','atlas-companion.service'],capture_output=True,text=True).stdout.strip()
    try: state=json.loads((STATE/'status.json').read_text())
    except (OSError,ValueError): state={}
    c=config(); device=c.get('pairedDevice')
    result={'service':service,'localUrl':'https://atlas-a1.local:5010','paired':bool(device),'pairedDevice':device,
            'fresh':time.time()-state.get('updatedAt',0)<20,**state}
    if a.json: print(json.dumps(result)); return
    connected=bool(state.get('clients',{})) and result['fresh']
    print('ATLAS APP\nServicio:',service,'\nRelay:',state.get('relay','sin configurar'))
    print('Dispositivo emparejado:',device or 'ninguno','\nConexión actual:','conectada' if connected else 'desconectada')
    print('Conversación activa:',state.get('voiceActive',False),'\nTerminales:',state.get('terminals',0))
if __name__=='__main__': main()
