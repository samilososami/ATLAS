{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atlas-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-09-03",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "relay.samilososami.com",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ATLAS_RELAY",
        "class_name": "AtlasRelay"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AtlasRelay"]
    }
  ]
}
