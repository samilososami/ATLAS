{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openatlas.local/schemas/role.schema.json",
  "title": "ATLAS role manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "displayName",
    "default",
    "context",
    "runtimeFacts",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "displayName": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "default": { "type": "boolean" },
    "context": { "type": "object" },
    "runtimeFacts": {
      "type": "object",
      "properties": {
        "currentDateTime": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "required": ["defaultPolicy", "allow", "deny"],
      "properties": {
        "defaultPolicy": { "enum": ["allow", "deny"] },
        "allow": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "deny": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "tools": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
